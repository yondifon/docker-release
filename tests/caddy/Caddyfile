
import /etc/caddy/conf.d/*.caddy

:80 {
    header -Server
    header -X-Powered-By
    header -Via

    encode gzip zstd

    @linear host linear.localhost
    handle @linear {
        header X-App linear
        header X-Frame-Options DENY
        header X-Content-Type-Options nosniff
        import linear_app_upstream
    }

    @canary host canary.localhost
    handle @canary {
        header X-App canary
        header X-Frame-Options DENY
        header X-Content-Type-Options nosniff
        import canary_app_upstream
    }

    @bluegreen host bluegreen.localhost
    handle @bluegreen {
        header X-App bluegreen
        header X-Frame-Options DENY
        header X-Content-Type-Options nosniff
        import blue_green_app_upstream
    }
}
